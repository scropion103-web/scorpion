# ─────────────────────────────────────────────────────────────
#  Perfume Café — environment variables
#  Copy to .env and fill in real values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (local, Docker, Neon, Supabase…)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/perfume_cafe?schema=public"

# Public site URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js — generate with:  npx auth secret   (or any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST=true

# First admin account (created by `pnpm db:seed`)
ADMIN_EMAIL="admin@perfumecafe.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Admin"

# Cloudflare R2 (S3-compatible). Leave empty to store uploads in /public/uploads during development.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public bucket URL or custom domain, e.g. https://cdn.perfumecafe.com  (no trailing slash)
R2_PUBLIC_URL=""

# WhatsApp Cloud API (Meta Graph API). Leave empty to disable automatic messages.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
# Number that receives "new order" alerts, international format without + (e.g. 201000000000)
WHATSAPP_ADMIN_NUMBER=""
# Optional approved template for customer confirmations (params: name, ref, total)
WHATSAPP_ORDER_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="ar"
